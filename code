def get_principal_axes_3D_only(coords):
    """Calcule le centre et le vecteur PCA principal (3D) SANS orientation. Coords [Z, Y, X]."""
    if len(coords) < 4: return np.zeros(3), np.zeros(3)
    pca = PCA(n_components=3)
    try:
        pca.fit(coords)
        if pca.explained_variance_ratio_[0] < 0.1 or pca.explained_variance_[0] < 1e-6:
             return np.zeros(3), np.zeros(3)

        center = np.mean(coords, axis=0)
        v_pca = pca.components_[0]
        
        return center, v_pca
    except Exception:
        return np.zeros(3), np.zeros(3)

def calculate_angle_0_180_rl_oriented(center_2D, v_pca_3D, reference_line_axis, reference_line_value, base_point, kd_tree_axe_x_lissé, coords_axe_x_xy_lissé, TANGENT_WINDOW_SIZE, proj_axe_x_z, TANGENT_ROI_SIZE, height, width):
    """
    Calcule l'angle non orienté [0° à 180°] entre la Tangente X et le Pôle PCA,
    où le Pôle PCA est orienté en fonction de la Ligne de Référence (RL).
    Retourne également le PCA orienté par la Tangente X (v_pca_orienté_tangente) pour la correction.
    """
    # Si données insuffisantes
    if coords_axe_x_xy_lissé.size == 0 or kd_tree_axe_x_lissé is None:
        v_default = np.array([1.0, 0.0])
        # Retourne 6 valeurs: (angle, intersection, v_tangente, v_pca_rl, v_ref_orient, v_pca_tangente)
        return 0.0, center_2D, v_default, v_default, v_default, v_default 

    # 1. ANCRAGE DE LA TANGENTE X (inchangé)
    i_pixel_initial = kd_tree_axe_x_lissé.query(center_2D)[1]
    intersection_initial = coords_axe_x_xy_lissé[i_pixel_initial]
    
    roi_size = TANGENT_ROI_SIZE
    x_int, y_int = intersection_initial.astype(int)
    x_min, x_max = max(0, x_int - roi_size // 2), min(width, x_int + roi_size // 2 + 1)
    y_min, y_max = max(0, y_int - roi_size // 2), min(height, y_int + roi_size // 2 + 1)
    roi = proj_axe_x_z[y_min:y_max, x_min:x_max]

    if roi.size > 0 and roi.max() > 0:
        max_intensity_idx = np.unravel_index(np.argmax(roi), roi.shape)
        max_intensity_point = np.array([x_min + max_intensity_idx[1], y_min + max_intensity_idx[0]])
    else:
        max_intensity_point = intersection_initial

    i_pixel_final_anchor = kd_tree_axe_x_lissé.query(max_intensity_point)[1]
    intersection_exact = coords_axe_x_xy_lissé[i_pixel_final_anchor]

    # 2. CALCUL ET ORIENTATION DE LA TANGENTE X (VERS le BP - inchangé)
    window_size = TANGENT_WINDOW_SIZE
    N_lissé = len(coords_axe_x_xy_lissé)
    idx_prev = (i_pixel_final_anchor - window_size) % N_lissé
    idx_next = (i_pixel_final_anchor + window_size) % N_lissé
    v_tangent_unnorm = (coords_axe_x_xy_lissé[idx_next] - coords_axe_x_xy_lissé[idx_prev]).astype(float)
    norm_tangent = np.linalg.norm(v_tangent_unnorm)
    v_tangent_initial_norm = v_tangent_unnorm / norm_tangent if norm_tangent > 1e-6 else np.array([1.0, 0.0])

    v_intersection_to_bp = base_point - intersection_exact
    v_tangent_orienté = v_tangent_initial_norm
    if np.dot(v_tangent_initial_norm, v_intersection_to_bp) < 0:
        v_tangent_orienté = -v_tangent_initial_norm

    # Projection 2D et normalisation du PCA 3D
    v_pca_2D = v_pca_3D[[2, 1]] # Extrait X et Y (indices 2 et 1 du format [Z, Y, X])
    norm_pca = np.linalg.norm(v_pca_2D)
    v_pca_initial_norm = v_pca_2D / norm_pca if norm_pca > 1e-6 else np.array([1.0, 0.0])
    
    
    # 3. PÔLE PCA ORIENTÉ PAR LA LIGNE DE RÉFÉRENCE (RL) [LOGIQUE PRINCIPALE]
    
    coord_index_2D = 0 if reference_line_axis == 2 else 1 
    center_coord = center_2D[coord_index_2D]
    center_rl_diff = center_coord - reference_line_value
    
    # Vecteur d'orientation souhaité : LOIN de la Ligne de Référence (RL)
    v_desired_orientation = np.zeros(2)
    if coord_index_2D == 0: 
        v_desired_orientation[0] = -np.sign(center_rl_diff) if abs(center_rl_diff) > 1e-6 else 1.0 
    else: 
        v_desired_orientation[1] = -np.sign(center_rl_diff) if abs(center_rl_diff) > 1e-6 else 1.0 
        
    v_pca_orienté_rl = v_pca_initial_norm.copy()
    if np.dot(v_pca_initial_norm, v_desired_orientation) < 0:
        v_pca_orienté_rl = -v_pca_orienté_rl
        
    v_reference_orientation = v_desired_orientation


    # 3b. PÔLE PCA ORIENTÉ PAR LA TANGENTE X / BP [LOGIQUE DE SECOURS/CORRECTION]
    # On oriente le PCA dans la même direction que la Tangente X (orientée vers BP)
    v_pca_orienté_tangente = v_pca_initial_norm.copy()
    if np.dot(v_pca_initial_norm, v_tangent_orienté) < 0:
        v_pca_orienté_tangente = -v_pca_orienté_tangente


    # 4. CALCUL DE L'ANGLE NON ORIENTÉ [0°, 180°] (entre Tangente orientée et PCA orienté par RL)
    dot_prod = np.dot(v_tangent_orienté, v_pca_orienté_rl)
    angle_deg_0_180 = np.degrees(np.arccos(np.clip(dot_prod, -1.0, 1.0)))

    return (angle_deg_0_180, intersection_exact,
            v_tangent_orienté, v_pca_orienté_rl, v_reference_orientation, v_pca_orienté_tangente) 

