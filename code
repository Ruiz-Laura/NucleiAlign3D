# --------------------------------------------------------------------
records = []
tree = KDTree(coords)

for i, label in enumerate(labels_valides):
    target_pos = coords[i]
    target_vec = vectors[i]

    distances, idxs = tree.query(target_pos, k=len(coords))
    neighbors_idx = [j for j,d in zip(idxs,distances) if 0 < d < MAX_DIST_PIXELS]

    for n_idx in neighbors_idx:
        neighbor_label = labels_valides[n_idx]
        neighbor_vec = vectors[n_idx]

        # produit scalaire ABS en 3D
        dot_abs = np.abs(np.dot(target_vec, neighbor_vec))

        records.append({
            'Cellule': label,
            'Voisin': neighbor_label,
            'ProduitScalaireAbs': dot_abs
