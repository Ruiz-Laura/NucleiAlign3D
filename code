           target_vec[2], target_vec[1], target_vec[0],
           color='red', length=5, normalize=True, label='Cellule cible')

# voisins
for i, vec in enumerate(v_neighbors):
    neighbor_pos = neighbors[i]

    # produit scalaire en valeur absolue
    dot_abs = np.abs(np.dot(target_vec, vec))

    color = 'green' if dot_abs > 0.9 else 'orange' if dot_abs > 0.5 else 'blue'

    ax2.quiver(neighbor_pos[2], neighbor_pos[1], neighbor_pos[0],
               vec[2], vec[1], vec[0],
               color=color, length=5, normalize=True)

ax2.scatter(target[2], target[1], target[0], color='red', s=60)
ax2.scatter(neighbors[:,2], neighbors[:,1], neighbors[:,0], color='blue', s=40, alpha=0.5)

