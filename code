import numpy as np
import tifffile as tiff
import matplotlib.pyplot as plt
from scipy.spatial import KDTree
import pandas as pd
import os

# ====================================================================
# CONFIGURATION
# ====================================================================
MAX_DIST_PIXELS = 110  # distance max pour considérer un voisin

# ---------------- PARAMÈTRES POUR VECTEURS 2D -----------------------
# Ici on simule des vecteurs aléatoires pour chaque cellule
# Remplace par tes vecteurs réels si tu les as déjà
np.random.seed(0)

# --------------------------------------------------------------------
# CHARGEMENT DES DONNÉES
# --------------------------------------------------------------------
mask_vol = tiff.imread(mask_file)
unique_labels = np.unique(mask_vol)
unique_labels = unique_labels[unique_labels != 0]

coords = []
labels_valides = []
for label_id in unique_labels:
    voxels = np.argwhere(mask_vol == label_id)
    if voxels.size > 0:
        centroid = np.mean(voxels, axis=0)  # [Z,Y,X]
        coords.append(centroid)
        labels_valides.append(label_id)

coords = np.array(coords)

# --------------------------------------------------------------------
# VECTEURS BASÉS SUR L'AXE LONG (PCA)
# --------------------------------------------------------------------
from sklearn.decomposition import PCA

vectors = []

for label_id in labels_valides:
    voxels = np.argwhere(mask_vol == label_id)
    
    if len(voxels) > 5:  # sécurité pour cellules très petites
        pca = PCA(n_components=3)
        pca.fit(voxels)
        principal_axis = pca.components_[0]  # axe principal
        principal_axis = principal_axis / np.linalg.norm(principal_axis)
        vectors.append(principal_axis)
    else:
        vectors.append(np.array([0,0,0]))  # fallback si trop petite

vectors = np.array(vectors)

# --------------------------------------------------------------------
# FIGURE 1 : Voisins 3D d'une cellule cible
# --------------------------------------------------------------------
LABEL_CIBLE = 34
fig1 = plt.figure(figsize=(10, 8))
ax1 = fig1.add_subplot(111, projection='3d')
ax1.set_title(f"Voisins 3D de la cellule {LABEL_CIBLE}", fontsize=14)

tree = KDTree(coords)
idx_target = labels_valides.index(LABEL_CIBLE)
target = coords[idx_target]
distances = np.linalg.norm(coords - target, axis=1)
idxs = np.where((distances > 0) & (distances < MAX_DIST_PIXELS))[0]
neighbors = coords[idxs]

ax1.scatter(coords[:, 2], coords[:, 1], coords[:, 0],
            c='lightgrey', s=20, alpha=0.2, label='Toutes cellules')
ax1.scatter(neighbors[:, 2], neighbors[:, 1], neighbors[:, 0],
            c='blue', s=40, alpha=0.6, label='Voisins proches')
