# FONCTIONS DE LISSAGE ET D'EXTRACTION DE CONTOUR
# ====================================================================
def smooth_coords(coords, window_size):
    """Applique une moyenne glissante pour lisser et régulariser le contour (fermé)."""
    N = coords.shape[0]
    if N < window_size or window_size <= 1:
        return coords

    pad_len = window_size // 2
    end_pad = pad_len - (window_size % 2 == 0)

    coords_x_padded = np.pad(coords[:, 0], (pad_len, end_pad), mode='wrap')
    coords_y_padded = np.pad(coords[:, 1], (pad_len, end_pad), mode='wrap')

    kernel = np.ones(window_size) / window_size
    x_smoothed = np.convolve(coords_x_padded, kernel, mode='valid')
    y_smoothed = np.convolve(coords_y_padded, kernel, mode='valid')

    min_len = min(N, len(x_smoothed))
    return np.vstack((x_smoothed[:min_len], y_smoothed[:min_len])).T

def get_external_shifted_contour_curve(image_projection, threshold_value, shift_pixels, min_contour_length, smoothing_window):
    """
    Détecte le contour externe décalé, sélectionne le plus long et applique le lissage.
    """
    binary_image = image_projection > threshold_value
    binary_image = binary_fill_holes(binary_image)

    if shift_pixels > 0:
        selem = disk(shift_pixels)
        shifted_binary_image = binary_erosion(binary_image, selem)
    else:
        shifted_binary_image = binary_image

    contours = measure.find_contours(shifted_binary_image, 0.5)

    if not contours:
        return np.zeros((0,2))

    longest_contour = None
    max_length = 0

    for contour in contours:
        contour_xy = contour[:, [1, 0]]
        if len(contour_xy) > min_contour_length:
            if len(contour_xy) > max_length:
                max_length = len(contour_xy)
                longest_contour = contour_xy

    if longest_contour is None:
        return np.zeros((0,2))

    if smoothing_window > 1:
        longest_contour = smooth_coords(longest_contour, smoothing_window)

    return longest_contour

