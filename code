ax1.legend()
plt.tight_layout()
plt.show()

print(f" {len(neighbors)} voisins trouvés pour le label {LABEL_CIBLE} (< {MAX_DIST_PIXELS} px)")

# --------------------------------------------------------------------
# FIGURE 2 : Comparaison vecteurs 3D (produit scalaire ABS)
# --------------------------------------------------------------------
target_vec = vectors[idx_target]
v_neighbors = vectors[idxs]

fig2 = plt.figure(figsize=(10, 8))
ax2 = fig2.add_subplot(111, projection='3d')
ax2.set_title("Comparaison des vecteurs en 3D (|produit scalaire|)", fontsize=14)

